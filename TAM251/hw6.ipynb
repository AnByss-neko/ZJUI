   "source": [
    "import numpy as np\n",
    "from scipy.optimize import fsolve\n",
    "P = 11 # kN\n",
    "a = 3 # m\n",
    "\n",
    "V1 = -P\n",
    "def equations(vars):\n",
    "    N1 ,N2 = vars\n",
    "    eq1 = N1+N2-3*P\n",
    "    eq2 = P*a + N2*3*a - 2*P*2*a\n",
    "    return [eq1,eq2]\n",
    "ig = [1,1]\n",
    "N1 = fsolve(equations,ig)[0]\n",
    "N2 = fsolve(equations,ig)[1]\n",
    "print(N1,N2)"
   ]
